# AI Expense Tracker — Backend Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL — Supabase (or any Postgres provider)
# Get your connection string from: Supabase → Settings → Database → URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# AI API — Google Gemini
# Get a free key at: https://aistudio.google.com/app/apikey
# Leave blank to disable AI features (app still works without it).
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173
